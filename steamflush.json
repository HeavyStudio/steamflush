{
    "app-id": "io.github.heavystudio.steamflush",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "steamflush",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--filesystem=home"
    ],
    "modules": [
        {
            "name": "steamflush",
            "buildsystem": "simple",
            "build-commands": [
                "install -D steamflush /app/bin/steamflush"
            ],
            "sources": [
                {
                    "type": "file",
                    "path": "build/bin/steamflush"
                }
            ]
        }
    ]
}