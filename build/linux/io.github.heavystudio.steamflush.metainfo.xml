<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.heavystudio.steamflush</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <name>SteamFlush</name>
  <summary>Clean what Steam leaves behind</summary>
  <summary xml:lang="fr">Nettoyez ce que Steam laisse derrière lui</summary>

  <developer id="io.github.heavystudio">
    <name>Jonathan Alfonso</name>
  </developer>

  <description>
    <p>
      SteamFlush helps you reclaim disk space on your Steam Deck or Linux PC by
      identifying and deleting remnant files from uninstalled Steam games.
    </p>
    <p xml:lang="fr">
      SteamFlush vous aide à récupérer de l'espace disque sur votre Steam Deck ou PC Linux en identifiant et supprimant les fichiers restants des jeux Steam désinstallés.
    </p>
  </description>

  <launchable type="desktop-id">io.github.heavystudio.steamflush.desktop</launchable>
  
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/HeavyStudio/steamflush/refs/heads/main/screenshots/main_window.png</image>
