      <caption xml:lang="fr">Liste des fichiers orphelins détectés</caption>
    </screenshot>

    <screenshot>
        <image>https://raw.githubusercontent.com/HeavyStudio/steamflush/refs/heads/main/screenshots/clean_history.png</image>
        <caption>Detailed deletion history log</caption>
        <caption xml:lang="fr">Historique détaillé des nettoyages</caption>
    </screenshot>

    <screenshot>
        <image>https://raw.githubusercontent.com/HeavyStudio/steamflush/refs/heads/main/screenshots/system_clean.png</image>
        <caption>Clean state notification</caption>
        <caption xml:lang="fr">Écran de confirmation lorsque le système est propre</caption>
    </screenshot>
  </screenshots>

  <url type="homepage">https://github.com/HeavyStudio/steamflush</url>
